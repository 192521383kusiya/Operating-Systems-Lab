#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/ipc.h>
#include <sys/msg.h>

struct message
{
    long message_type;
    char message_text[100];
};

int main()
{
    key_t key;
    int msgid;
    struct message msg;

    // Generate a unique key
    key = ftok("msgfile", 65);

    // Create message queue
    msgid = msgget(key, 0666 | IPC_CREAT);

    if (msgid == -1)
    {
        perror("Message queue creation failed");
        exit(1);
    }

    // Send message
    msg.message_type = 1;

    printf("Enter message: ");
    fgets(msg.message_text, 100, stdin);

    msg.message_text[strcspn(msg.message_text, "\n")] = '\0';

    if (msgsnd(msgid, &msg, sizeof(msg.message_text), 0) == -1)
    {
        perror("Message sending failed");
        exit(1);
    }

    printf("\nMessage sent successfully.\n");

    // Receive message
    if (msgrcv(msgid, &msg, sizeof(msg.message_text), 1, 0) == -1)
    {
        perror("Message receiving failed");
        exit(1);
    }

    printf("Message received: %s\n", msg.message_text);

    // Remove message queue
    if (msgctl(msgid, IPC_RMID, NULL) == -1)
    {
        perror("Message queue removal failed");
        exit(1);
    }

    printf("Message queue removed successfully.\n");

    return 0;
}
