#include <stdio.h>

int main()
{
    int n, i, block, index[20];

    printf("Enter number of file blocks: ");
    scanf("%d", &n);

    printf("Enter the block numbers:\n");

    for (i = 0; i < n; i++)
    {
        printf("Block %d: ", i + 1);
        scanf("%d", &index[i]);
    }

    printf("\nIndexed File Allocation:\n");

    printf("Index Block\n");

    for (i = 0; i < n; i++)
    {
        printf("Index %d -> Block %d\n", i + 1, index[i]);
    }

    printf("\nEnter block number to access: ");
    scanf("%d", &block);

    if (block < 1 || block > n)
    {
        printf("Invalid block number.\n");
    }
    else
    {
        printf("Index %d points to File Block %d\n",
               block, index[block - 1]);
    }

    return 0;
}
