#include <stdio.h>
#include <stdlib.h>
#include <pthread.h>
#include <unistd.h>

#define NUM_THREADS 3

int counter = 0;

// Declare mutex
pthread_mutex_t mutex;

void *incrementCounter(void *arg)
{
    int threadID = *(int *)arg;

    for (int i = 0; i < 5; i++)
    {
        // Lock the mutex before entering critical section
        pthread_mutex_lock(&mutex);

        printf("Thread %d entered critical section.\n", threadID);

        // Critical section
        counter++;

        printf("Thread %d: Counter = %d\n",
               threadID, counter);

        sleep(1);

        printf("Thread %d leaving critical section.\n",
               threadID);

        // Unlock the mutex
        pthread_mutex_unlock(&mutex);

        sleep(1);
    }

    return NULL;
}

int main()
{
    pthread_t threads[NUM_THREADS];
    int threadID[NUM_THREADS];

    // Initialize mutex
    pthread_mutex_init(&mutex, NULL);

    // Create threads
    for (int i = 0; i < NUM_THREADS; i++)
    {
        threadID[i] = i + 1;

        pthread_create(&threads[i],
                       NULL,
                       incrementCounter,
                       &threadID[i]);
    }

    // Wait for all threads
    for (int i = 0; i < NUM_THREADS; i++)
    {
        pthread_join(threads[i], NULL);
    }

    // Destroy mutex
    pthread_mutex_destroy(&mutex);

    printf("\nFinal Counter Value = %d\n", counter);

    return 0;
}
