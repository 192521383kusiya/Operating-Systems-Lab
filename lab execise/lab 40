#include <stdio.h>
#include <sys/stat.h>

int main()
{
    struct stat file;
    char filename[100];

    printf("Enter file name: ");
    scanf("%s", filename);

    if (stat(filename, &file) != 0)
    {
        printf("File not found.\n");
        return 1;
    }

    printf("\nFile Access Permissions:\n");

    printf("Owner : ");
    printf("%c", (file.st_mode & S_IRUSR) ? 'r' : '-');
    printf("%c", (file.st_mode & S_IWUSR) ? 'w' : '-');
    printf("%c\n", (file.st_mode & S_IXUSR) ? 'x' : '-');

    printf("Group : ");
    printf("%c", (file.st_mode & S_IRGRP) ? 'r' : '-');
    printf("%c", (file.st_mode & S_IWGRP) ? 'w' : '-');
    printf("%c\n", (file.st_mode & S_IXGRP) ? 'x' : '-');

    printf("Others: ");
    printf("%c", (file.st_mode & S_IROTH) ? 'r' : '-');
    printf("%c", (file.st_mode & S_IWOTH) ? 'w' : '-');
    printf("%c\n", (file.st_mode & S_IXOTH) ? 'x' : '-');

    printf("\nTypes of Users in Linux:\n");
    printf("1. Owner\n");
    printf("2. Group\n");
    printf("3. Others\n");

    return 0;
}
