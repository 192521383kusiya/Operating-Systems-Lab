#include <stdio.h>
#include <stdlib.h>

int main()
{
    int request[50];
    int n, head, i;
    int totalHeadMovement = 0;

    printf("Enter number of disk requests: ");
    scanf("%d", &n);

    printf("Enter disk requests:\n");
    for (i = 0; i < n; i++)
    {
        scanf("%d", &request[i]);
    }

    printf("Enter initial head position: ");
    scanf("%d", &head);

    printf("\nFCFS Disk Scheduling:\n");
    printf("Order: %d", head);

    for (i = 0; i < n; i++)
    {
        totalHeadMovement += abs(head - request[i]);
        head = request[i];

        printf(" -> %d", request[i]);
    }

    printf("\n\nTotal Head Movement = %d cylinders\n",
           totalHeadMovement);

    return 0;
}
