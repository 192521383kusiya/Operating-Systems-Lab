#include <stdio.h>
#include <string.h>

int main()
{
    char line[200];
    char word[50];
    int n, i;

    printf("Enter number of lines: ");
    scanf("%d", &n);

    printf("Enter the lines:\n");

    getchar();

    char lines[n][200];

    for (i = 0; i < n; i++)
    {
        fgets(lines[i], sizeof(lines[i]), stdin);
    }

    printf("Enter word to search: ");
    scanf("%s", word);

    printf("\nLines containing the word '%s':\n", word);

    for (i = 0; i < n; i++)
    {
        if (strstr(lines[i], word) != NULL)
        {
            printf("%s", lines[i]);
        }
    }

    return 0;
}
