#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>
#include <string.h>

int main()
{
    int fd;
    char writeData[] = "Hello! This is UNIX file management.";
    char readData[100];
    ssize_t bytesRead;

    // Open/Create file
    fd = open("sample.txt", O_CREAT | O_RDWR, 0644);

    if (fd == -1)
    {
        perror("Error opening file");
        return 1;
    }

    printf("File opened successfully.\n");

    // Write data to file
    if (write(fd, writeData, strlen(writeData)) == -1)
    {
        perror("Error writing to file");
        close(fd);
        return 1;
    }

    printf("Data written successfully.\n");

    // Move file pointer to beginning
    if (lseek(fd, 0, SEEK_SET) == -1)
    {
        perror("Error using lseek");
        close(fd);
        return 1;
    }

    // Read data from file
    bytesRead = read(fd, readData, sizeof(readData) - 1);

    if (bytesRead == -1)
    {
        perror("Error reading file");
        close(fd);
        return 1;
    }

    readData[bytesRead] = '\0';

    printf("Data read from file: %s\n", readData);

    // Close file
    close(fd);

    printf("File closed successfully.\n");

    return 0;
}
