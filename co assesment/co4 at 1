#include <stdio.h>
#define MAX 100
int main()
{
    int disk[MAX] = {0};
    int diskSize, fileSize, method;
    int i, j, count, start, indexBlock;
    printf("Enter total disk size (number of blocks): ");
    scanf("%d", &diskSize);
    printf("Enter file size (number of blocks required): ");
    scanf("%d", &fileSize);
    printf("\nFile Allocation Methods\n");
    printf("1. Contiguous Allocation\n");
    printf("2. Linked Allocation\n");
    printf("3. Indexed Allocation\n");
    printf("Enter allocation method: ");
    scanf("%d", &method);
    if (diskSize <= 0 || diskSize > MAX || fileSize <= 0 || fileSize > diskSize)
    {
        printf("Invalid input.\n");
        return 0;
    }
    /* ---------------- CONTIGUOUS ---------------- */
    if (method == 1)
    {
        int found = 0;
        for (start = 0; start <= diskSize - fileSize; start++)
        {
            count = 0;
            for (i = start; i < start + fileSize; i++)
            {
                if (disk[i] == 0)
                    count++;
                else
                    break;
            }
            if (count == fileSize)
            {
                found = 1;
                break;
            }
        }
        if (found)
        {
            printf("\nContiguous Allocation successful.\n");
            printf("Allocated blocks: ");
            for (i = start; i < start + fileSize; i++)
            {
                disk[i] = 1;
                printf("%d ", i);
            }
            printf("\nStarting block: %d\n", start);
            printf("Ending block: %d\n", start + fileSize - 1);
        }
        else
        {
            printf("\nContiguous Allocation failed.\n");
            printf("Insufficient continuous free space.\n");
            printf("Fragmentation prevents allocation even if enough total free blocks exist.\n");
        }
    }
    /* ---------------- LINKED ---------------- */
    else if (method == 2)
    {
        count = 0;
        for (i = 0; i < diskSize && count < fileSize; i++)
        {
            if (disk[i] == 0)
            {
                disk[i] = 1;
                count++;
            }
        }
        if (count == fileSize)
        {
            printf("\nLinked Allocation successful.\n");
            printf("Allocated blocks: ");
            for (i = 0; i < diskSize; i++)
            {
                if (disk[i] == 1)
                    printf("%d ", i);
            }
            printf("\n");
        }
        else
        {
            printf("\nLinked Allocation failed.\n");
            printf("Not enough free blocks available.\n");
        }
    }
    /* ---------------- INDEXED ---------------- */
    else if (method == 3)
    {
        indexBlock = -1;
        /* Find one block for the index */
        for (i = 0; i < diskSize; i++)
        {
            if (disk[i] == 0)
            {
                indexBlock = i;
                disk[i] = 1;
                break;
            }
        }
        if (indexBlock == -1 || diskSize - 1 < fileSize)
        {
            printf("\nIndexed Allocation failed.\n");
            printf("Not enough blocks for index block and file data.\n");
        }
        else
        {
            count = 0;
            for (i = 0; i < diskSize && count < fileSize; i++)
            {
                if (disk[i] == 0)
                {
                    disk[i] = 1;
                    count++;
                }
            }
            if (count == fileSize)
            {
                printf("\nIndexed Allocation successful.\n");
                printf("Index block: %d\n", indexBlock);
                printf("Allocated data blocks: ");
                for (i = 0; i < diskSize; i++)
                {
                    if (disk[i] == 1 && i != indexBlock)
                        printf("%d ", i);
                }
                printf("\n");
            }
            else
            {
                printf("\nIndexed Allocation failed.\n");
                printf("Not enough free blocks for the file.\n");
            }
        }
    }
    else
    {
        printf("\nInvalid allocation method.\n");
    }
    return 0;
}
